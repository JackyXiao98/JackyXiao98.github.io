---
layout: default
---

<div class="tech-grid" aria-hidden="true"></div>

<div class="tech-home tech-cv">
  <header class="tech-cv-header">
    <div class="tech-prompt"><span class="tech-prompt-user">guest@yingtai</span>:<span class="tech-prompt-path">~</span>$ cat cv.md</div>
    <h1 class="tech-name"><span class="tech-gradient-text">{{ site.first_name }} {{ site.last_name }}</span></h1>
    {% if page.description %}<p class="tech-role">{{ page.description }}</p>{% endif %}
    <div class="tech-links">
      <a class="tech-btn" href="mailto:{{ site.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span>{{ site.email }}</span></a>
      <a class="tech-btn" href="{{ '/publications/' | relative_url }}"><i class="ti ti-file-text" aria-hidden="true"></i><span>Publications</span></a>
      <a class="tech-btn" href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i><span>GitHub</span></a>
    </div>
  </header>

  {% for section in site.data.cv %}
    <section class="tech-section">
      <h2 class="tech-heading">
        <span class="tech-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ section.title }}
      </h2>

      {% if section.type == 'timeline' %}
        <div class="tech-cv-timeline">
          {% for item in section.contents %}
            <div class="tech-card tech-cv-item">
              <div class="tech-cv-item-head">
                <h3>{{ item.title }}</h3>
                {% if item.year %}<span class="tech-timeline-date">{{ item.year }}</span>{% endif %}
              </div>
              <div class="tech-cv-institution">{{ item.institution }}</div>
              {% if item.description %}
                <ul>
                  {% for d in item.description %}<li>{{ d | markdownify | remove: '<p>' | remove: '</p>' }}</li>{% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% elsif section.type == 'publications' %}
        <ol class="tech-card tech-cv-pubs">
          {% for p in section.contents %}
            <li>
              <span class="tech-cv-tag">{{ p.tag }}</span>
              <div>
                <a class="tech-cv-pub-title" href="{{ p.url }}" target="_blank" rel="noopener">{{ p.title }}</a>
                <div class="tech-cv-authors">{{ p.authors | markdownify | remove: '<p>' | remove: '</p>' }}</div>
                <div class="tech-cv-venue">
                  {{ p.venue }}{% if p.note %} <span class="tech-cv-note">{{ p.note }}</span>{% endif %}
                </div>
              </div>
            </li>
          {% endfor %}
        </ol>
      {% elsif section.type == 'groups' %}
        <div class="tech-interests">
          {% for g in section.contents %}
            <div class="tech-card tech-cv-group">
              <h3>{{ g.title }}</h3>
              <ul>
                {% for i in g.items %}<li>{{ i }}</li>{% endfor %}
              </ul>
            </div>
          {% endfor %}
        </div>
      {% elsif section.type == 'tags' %}
        <div class="tech-chips">
          {% for t in section.contents %}<span class="tech-chip">{{ t }}</span>{% endfor %}
        </div>
      {% endif %}
    </section>
  {% endfor %}
</div>
